{
  "fonts": {
    "primary": "Montserrat",
    "fallback": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Open Sans", "Helvetica Neue", "sans-serif"],
    "aliases": {
      "Proxima Nova": "Montserrat",
      "Coolvetica": "Montserrat"
    },
    "tailwindUtilities": {
      "font-primary": ["Montserrat", "sans-serif"],
      "font-secondary": ["Montserrat", "sans-serif"]
    }
  },
  "colors": {
    "brand": {
      "green-primary": {
        "hex": "#16956C",
        "usage": ["headings", "active tabs", "nav underlines", "quiz cards", "auth form background"]
      },
      "green-light": {
        "hex": "#2ACB8F",
        "usage": ["splash screen gradient start"]
      },
      "green-accent": {
        "hex": "#21A279",
        "usage": ["SVG accents inside cards"]
      }
    },
    "teal": {
      "teal-default": {
        "hex": "#1B7A93",
        "usage": ["practice button background"]
      },
      "teal-hover": {
        "hex": "#166A80",
        "usage": ["practice button hover state"]
      },
      "blue-icon": {
        "hex": "#2AA0DA",
        "usage": ["SVG/icon fill", "chat icon"]
      }
    },
    "dark": {
      "navy": {
        "hex": "#14213D",
        "usage": ["ad/promo banner background"]
      },
      "dark-gray": {
        "hex": "#4B4D52",
        "usage": ["auth screen heading text"]
      }
    },
    "neutral": {
      "gray-50": {
        "tailwind": "gray-50",
        "usage": ["auth layout outer background"]
      },
      "gray-100": {
        "tailwind": "gray-100",
        "usage": ["background surfaces"]
      },
      "gray-400": {
        "tailwind": "gray-400",
        "usage": ["inactive tab labels"]
      },
      "gray-700": {
        "tailwind": "gray-700",
        "usage": ["secondary body text"]
      }
    },
    "accent": {
      "yellow": {
        "tailwind": "yellow-500",
        "usage": ["coming soon badge"]
      },
      "red": {
        "tailwind": "red-600",
        "usage": ["CTA / action buttons"]
      },
      "orange-light": {
        "tailwind": "orange-200",
        "usage": ["referral section highlights"]
      },
      "orange-dark": {
        "tailwind": "orange-500",
        "usage": ["referral section highlights"]
      }
    },
    "base": {
      "white": {
        "hex": "#ffffff",
        "usage": ["app background", "PWA manifest theme color", "PWA manifest background color"]
      }
    }
  },
  "gradients": {
    "splash": {
      "type": "linear",
      "direction": "to-b",
      "from": "#2ACB8F",
      "to": "#16956C",
      "usage": ["splash screen", "onboarding screens"]
    }
  },
  "pwa": {
    "theme_color": "#ffffff",
    "background_color": "#ffffff"
  }
}
