# Which API the app talks to is decided by the Vite build mode, not by a flag:
#   npm run dev    -> VITE_API_DEV_URL  (local backend)
#   npm run build  -> VITE_API_URL      (deployed backend)
# There is no VITE_PROD switch any more; see src/lib/axios.js.

# Production API, including the /api/v1 suffix. Required for a production build
# -- the build fails fast rather than silently falling back to the local URL.
VITE_API_URL=https://your-production-api.example/api/v1

# Local API. Must match PORT in the backend .env (currently 5005).
# Never set this in a hosted deploy environment (Vercel etc.); it is local-only.
VITE_API_DEV_URL=http://localhost:5005/api/v1
